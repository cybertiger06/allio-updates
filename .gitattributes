# Git LFS para archivos pesados (JARs grandes, ZIPs)
*.jar filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Binarios - no hacer merge
*.jar binary
*.zip binary
*.png binary
*.ogg binary
*.nbt binary

# Archivos de instancia: servir byte-exactos (sin conversion CRLF<->LF)
# para que el sha256 del manifest coincida con lo que sirve raw.githubusercontent.com.
# Sin esto, autocrlf convierte CRLF->LF en el blob y el launcher rechaza los
# archivos de texto (json/mcmeta/txt) por hash mismatch.
instances/** -text
